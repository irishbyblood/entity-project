# OpenAI API Key (for GPT models, DALL-E, Sora)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (for Gemini, Veo)
GOOGLE_API_KEY=your_google_api_key_here

# Mistral API Key
MISTRAL_API_KEY=your_mistral_api_key_here

# xAI API Key (for Grok)
XAI_API_KEY=your_xai_api_key_here

# Microsoft API Key (for Copilot)
MICROSOFT_API_KEY=your_microsoft_api_key_here

# Midjourney API Key (if using third-party API)
MIDJOURNEY_API_KEY=your_midjourney_api_key_here

# IBM Watson API Key and URL
IBM_WATSON_API_KEY=your_ibm_watson_api_key_here
IBM_WATSON_URL=your_ibm_watson_url_here

# Tesla API Key (if available)
TESLA_API_KEY=your_tesla_api_key_here

# DeepMind API Key (if available)
DEEPMIND_API_KEY=your_deepmind_api_key_here
